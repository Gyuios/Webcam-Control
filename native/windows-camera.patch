+    uint32_t LoadAcquire32(const void* address)
+    {
+        const auto value = *static_cast<const volatile uint32_t*>(address);
+        MemoryBarrier();
+        return value;
+    }
+
+    uint64_t LoadAcquire64(const void* address)
+    {
+        const auto value = *static_cast<const volatile uint64_t*>(address);
+        MemoryBarrier();
+        return value;
+    }
+
+    uint64_t UnixTimeMicros()
+    {
+        FILETIME fileTime{};
+        GetSystemTimePreciseAsFileTime(&fileTime);
+        ULARGE_INTEGER ticks{};
+        ticks.LowPart = fileTime.dwLowDateTime;
+        ticks.HighPart = fileTime.dwHighDateTime;
+        constexpr uint64_t windowsToUnixEpoch100ns = 116444736000000000ULL;
+        return ticks.QuadPart > windowsToUnixEpoch100ns
+            ? (ticks.QuadPart - windowsToUnixEpoch100ns) / 10
+            : 0;
+    }
+
+    struct PersistentFrameMapping
+    {
+        wil::unique_hfile file;
+        wil::unique_handle mapping;
+        const BYTE* view = nullptr;
+        uint64_t mappedSize = 0;
+
+        ~PersistentFrameMapping()
+        {
+            Reset();
+        }
+
+        void Reset()
+        {
+            if (view)
+            {
+                UnmapViewOfFile(view);
+                view = nullptr;
+            }
+            mapping.reset();
+            file.reset();
+            mappedSize = 0;
+        }
+
+        bool Open()
+        {
+            Reset();
+            file.reset(CreateFileW(
+                kFramePath,
+                GENERIC_READ,
+                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                nullptr,
+                OPEN_EXISTING,
+                FILE_ATTRIBUTE_NORMAL | FILE_FLAG_RANDOM_ACCESS,
+                nullptr));
+            if (!file)
+            {
+                return false;
+            }
+            LARGE_INTEGER size{};
+            if (!GetFileSizeEx(file.get(), &size) ||
+                size.QuadPart < static_cast<LONGLONG>(sizeof(CameraTunerGlobalHeader)))
+            {
+                Reset();
+                return false;
+            }
+            mapping.reset(CreateFileMappingW(file.get(), nullptr, PAGE_READONLY, 0, 0, nullptr));
+            if (!mapping)
+            {
+                Reset();
+                return false;
+            }
+            view = static_cast<const BYTE*>(MapViewOfFile(mapping.get(), FILE_MAP_READ, 0, 0, 0));
+            if (!view)
+            {
+                Reset();
+                return false;
+            }
+            mappedSize = static_cast<uint64_t>(size.QuadPart);
+            return true;
+        }
+    };
