+    void ScaleBgraToCanvas(
+        const std::vector<BYTE>& source,
+        uint32_t sourceWidth,
+        uint32_t sourceHeight,
+        uint32_t destinationWidth,
+        uint32_t destinationHeight,
+        std::vector<BYTE>& destination)
+    {
+        destination.assign(
+            static_cast<size_t>(destinationWidth) * destinationHeight * 4,
+            0);
+        for (size_t pixel = 0; pixel < destination.size(); pixel += 4)
+        {
+            destination[pixel + 3] = 255;
+        }
+
+        uint32_t scaledWidth = destinationWidth;
+        uint32_t scaledHeight = destinationHeight;
+        if (static_cast<uint64_t>(sourceWidth) * destinationHeight >
+            static_cast<uint64_t>(destinationWidth) * sourceHeight)
+        {
+            scaledHeight = static_cast<uint32_t>(
+                static_cast<uint64_t>(sourceHeight) * destinationWidth / sourceWidth);
+        }
+        else
+        {
+            scaledWidth = static_cast<uint32_t>(
+                static_cast<uint64_t>(sourceWidth) * destinationHeight / sourceHeight);
+        }
+        scaledWidth = (std::max)(1u, scaledWidth);
+        scaledHeight = (std::max)(1u, scaledHeight);
+        const uint32_t offsetX = (destinationWidth - scaledWidth) / 2;
+        const uint32_t offsetY = (destinationHeight - scaledHeight) / 2;
+
+        for (uint32_t y = 0; y < scaledHeight; ++y)
+        {
+            const uint32_t sourceY = static_cast<uint32_t>(
+                static_cast<uint64_t>(y) * sourceHeight / scaledHeight);
+            for (uint32_t x = 0; x < scaledWidth; ++x)
+            {
+                const uint32_t sourceX = static_cast<uint32_t>(
+                    static_cast<uint64_t>(x) * sourceWidth / scaledWidth);
+                const size_t sourceOffset =
+                    (static_cast<size_t>(sourceY) * sourceWidth + sourceX) * 4;
+                const size_t destinationOffset =
+                    (static_cast<size_t>(y + offsetY) * destinationWidth + x + offsetX) * 4;
+                memcpy(destination.data() + destinationOffset, source.data() + sourceOffset, 4);
+            }
+        }
+    }
+
+    void CopyBgraRows(
+        const std::vector<BYTE>& source,
+        BYTE* destination,
+        LONG destinationPitch,
+        uint32_t width,
+        uint32_t height)
+    {
+        const auto rowSize = static_cast<size_t>(width) * 4;
+        for (uint32_t row = 0; row < height; ++row)
+        {
+            memcpy(destination + row * destinationPitch, source.data() + row * rowSize, rowSize);
+        }
+    }
+
+    void CopyNv12Rows(
+        const std::vector<BYTE>& source,
+        BYTE* destination,
+        LONG destinationPitch,
+        uint32_t width,
+        uint32_t height)
+    {
+        const size_t sourceLumaSize = static_cast<size_t>(width) * height;
+        for (uint32_t row = 0; row < height; ++row)
+        {
+            memcpy(destination + static_cast<size_t>(row) * destinationPitch,
+                source.data() + static_cast<size_t>(row) * width, width);
+        }
+        BYTE* destinationUv = destination + static_cast<size_t>(destinationPitch) * height;
+        const BYTE* sourceUv = source.data() + sourceLumaSize;
+        for (uint32_t row = 0; row < height / 2; ++row)
+        {
+            memcpy(destinationUv + static_cast<size_t>(row) * destinationPitch,
+                sourceUv + static_cast<size_t>(row) * width, width);
+        }
+    }
+
+    void ScaleNv12ToCanvas(
+        const std::vector<BYTE>& source,
+        uint32_t sourceWidth,
+        uint32_t sourceHeight,
+        uint32_t destinationWidth,
+        uint32_t destinationHeight,
+        std::vector<BYTE>& destination)
+    {
+        const size_t destinationLumaSize =
+            static_cast<size_t>(destinationWidth) * destinationHeight;
+        destination.resize(destinationLumaSize + destinationLumaSize / 2);
+        memset(destination.data(), 16, destinationLumaSize);
+        memset(destination.data() + destinationLumaSize, 128, destinationLumaSize / 2);
+
+        uint32_t scaledWidth = destinationWidth;
+        uint32_t scaledHeight = destinationHeight;
+        if (static_cast<uint64_t>(sourceWidth) * destinationHeight >
+            static_cast<uint64_t>(destinationWidth) * sourceHeight)
+        {
+            scaledHeight = static_cast<uint32_t>(
+                static_cast<uint64_t>(sourceHeight) * destinationWidth / sourceWidth);
+        }
+        else
+        {
+            scaledWidth = static_cast<uint32_t>(
+                static_cast<uint64_t>(sourceWidth) * destinationHeight / sourceHeight);
+        }
+        scaledWidth = (std::max)(2u, scaledWidth & ~1u);
+        scaledHeight = (std::max)(2u, scaledHeight & ~1u);
+        const uint32_t offsetX = ((destinationWidth - scaledWidth) / 2) & ~1u;
+        const uint32_t offsetY = ((destinationHeight - scaledHeight) / 2) & ~1u;
+        const size_t sourceLumaSize = static_cast<size_t>(sourceWidth) * sourceHeight;
+
+        for (uint32_t y = 0; y < scaledHeight; ++y)
+        {
+            const uint32_t sourceY = static_cast<uint32_t>(
+                static_cast<uint64_t>(y) * sourceHeight / scaledHeight);
+            for (uint32_t x = 0; x < scaledWidth; ++x)
+            {
+                const uint32_t sourceX = static_cast<uint32_t>(
+                    static_cast<uint64_t>(x) * sourceWidth / scaledWidth);
+                destination[static_cast<size_t>(y + offsetY) * destinationWidth + x + offsetX] =
+                    source[static_cast<size_t>(sourceY) * sourceWidth + sourceX];
+            }
+        }
+        BYTE* destinationUv = destination.data() + destinationLumaSize;
+        const BYTE* sourceUv = source.data() + sourceLumaSize;
+        for (uint32_t y = 0; y < scaledHeight / 2; ++y)
+        {
+            const uint32_t sourceY = static_cast<uint32_t>(
+                static_cast<uint64_t>(y) * (sourceHeight / 2) / (scaledHeight / 2));
+            for (uint32_t x = 0; x < scaledWidth; x += 2)
+            {
+                const uint32_t sourceX = (static_cast<uint32_t>(
+                    static_cast<uint64_t>(x) * sourceWidth / scaledWidth)) & ~1u;
+                const size_t sourceOffset = static_cast<size_t>(sourceY) * sourceWidth + sourceX;
+                const size_t destinationOffset =
+                    static_cast<size_t>(y + offsetY / 2) * destinationWidth + x + offsetX;
+                destinationUv[destinationOffset] = sourceUv[sourceOffset];
+                destinationUv[destinationOffset + 1] = sourceUv[sourceOffset + 1];
+            }
+        }
+    }
+
+    BYTE ClampColor(int value)
+    {
+        return static_cast<BYTE>((std::min)(255, (std::max)(0, value)));
+    }
+
+    void ConvertNv12ToBgra(
+        const std::vector<BYTE>& source,
+        uint32_t width,
+        uint32_t height,
+        std::vector<BYTE>& destination)
+    {
+        const size_t lumaSize = static_cast<size_t>(width) * height;
+        destination.resize(lumaSize * 4);
+        const BYTE* uv = source.data() + lumaSize;
+        for (uint32_t y = 0; y < height; ++y)
+        {
+            for (uint32_t x = 0; x < width; ++x)
+            {
+                const int c = (std::max)(0, static_cast<int>(source[static_cast<size_t>(y) * width + x]) - 16);
+                const size_t uvOffset = static_cast<size_t>(y / 2) * width + (x & ~1u);
+                const int d = static_cast<int>(uv[uvOffset]) - 128;
+                const int e = static_cast<int>(uv[uvOffset + 1]) - 128;
+                const size_t output = (static_cast<size_t>(y) * width + x) * 4;
+                destination[output] = ClampColor((298 * c + 516 * d + 128) >> 8);
+                destination[output + 1] = ClampColor((298 * c - 100 * d - 208 * e + 128) >> 8);
+                destination[output + 2] = ClampColor((298 * c + 409 * e + 128) >> 8);
+                destination[output + 3] = 255;
+            }
+        }
+    }
+}
 
