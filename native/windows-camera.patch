+    bool ReadCameraTunerFrame(
+        uint32_t& width,
+        uint32_t& height,
+        uint32_t& pixelFormat,
+        uint64_t& sequence,
+        std::vector<BYTE>& frame)
+    {
+        static LONG openFailureLogged = 0;
+        static LONG invalidHeaderLogged = 0;
+        static LONG unstableFrameLogged = 0;
+        static LONG successLogged = 0;
+        static PersistentFrameMapping persistent;
+        static std::mutex persistentMutex;
+        const std::lock_guard<std::mutex> lock(persistentMutex);
+
+        for (uint32_t mappingAttempt = 0; mappingAttempt < 2; ++mappingAttempt)
+        {
+        if (!persistent.view && !persistent.Open())
+        {
+            char message[96]{};
+            sprintf_s(message, "persistent mapping open failed: %lu", GetLastError());
+            LogDiagnosticOnce(openFailureLogged, message);
+            return false;
+        }
+
+        const auto* global = reinterpret_cast<const CameraTunerGlobalHeader*>(persistent.view);
+        CameraTunerGlobalHeader globalSnapshot{};
+        memcpy(&globalSnapshot, global, sizeof(globalSnapshot));
+        const uint32_t active = LoadAcquire32(&global->active);
+        const uint64_t heartbeat = LoadAcquire64(&global->heartbeatMicros);
+        const uint64_t now = UnixTimeMicros();
+        const uint64_t requiredSize = static_cast<uint64_t>(globalSnapshot.headerSize) +
+            static_cast<uint64_t>(globalSnapshot.slotSpan) * globalSnapshot.slotCount;
+        const bool validGlobal =
+            memcmp(globalSnapshot.magic, kFrameMagic, sizeof(globalSnapshot.magic)) == 0 &&
+            globalSnapshot.headerSize == kFrameHeaderSize &&
+            globalSnapshot.slotCount == kFrameSlotCount &&
+            globalSnapshot.slotSpan >= sizeof(CameraTunerSlotHeader) + globalSnapshot.frameCapacity &&
+            globalSnapshot.slotSpan % 64 == 0 &&
+            globalSnapshot.frameCapacity > 0 &&
+            globalSnapshot.frameCapacity <= 256u * 1024u * 1024u &&
+            (globalSnapshot.pixelFormat == kPixelFormatBgra ||
+                globalSnapshot.pixelFormat == kPixelFormatNv12) &&
+            requiredSize <= persistent.mappedSize;
+        const bool heartbeatCurrent = heartbeat > 0 && now >= heartbeat &&
+            now - heartbeat <= kHeartbeatMaxAgeMicros;
+        if (!validGlobal || active == 0 || !heartbeatCurrent)
+        {
+            if (!validGlobal)
+            {
+                char message[224]{};
+                sprintf_s(
+                    message,
+                    "invalid CTFRAME2 header: magic=%.8s header=%u slots=%u span=%u capacity=%u format=%u active=%u file=%llu",
+                    globalSnapshot.magic,
+                    globalSnapshot.headerSize,
+                    globalSnapshot.slotCount,
+                    globalSnapshot.slotSpan,
+                    globalSnapshot.frameCapacity,
+                    globalSnapshot.pixelFormat,
+                    active,
+                    static_cast<unsigned long long>(persistent.mappedSize));
+                LogDiagnosticOnce(invalidHeaderLogged, message);
+            }
+            persistent.Reset();
+            if (mappingAttempt == 0)
+            {
+                continue;
+            }
+            return false;
+        }
+
+        for (uint32_t attempt = 0; attempt < 4; ++attempt)
+        {
+            const uint64_t publicationBefore = LoadAcquire64(&global->publication);
+            const uint32_t slotValue = static_cast<uint32_t>(publicationBefore & 3);
+            const uint64_t publishedSequence = publicationBefore >> 2;
+            if (slotValue == 0 || slotValue > kFrameSlotCount || publishedSequence == 0)
+            {
+                return false;
+            }
+            const uint64_t slotOffset = globalSnapshot.headerSize +
+                static_cast<uint64_t>(slotValue - 1) * globalSnapshot.slotSpan;
+            const auto* slot = reinterpret_cast<const CameraTunerSlotHeader*>(
+                persistent.view + slotOffset);
+            const uint32_t stateBefore = LoadAcquire32(&slot->state);
+            const uint64_t sequenceBefore = LoadAcquire64(&slot->sequence);
+            if (stateBefore != kSlotStatePublished || sequenceBefore != publishedSequence)
+            {
+                SwitchToThread();
+                continue;
+            }
+
+            CameraTunerSlotHeader slotSnapshot{};
+            memcpy(&slotSnapshot, slot, sizeof(slotSnapshot));
+            const uint64_t lumaSize =
+                static_cast<uint64_t>(slotSnapshot.width) * slotSnapshot.height;
+            const uint64_t expectedSize = slotSnapshot.pixelFormat == kPixelFormatBgra
+                ? lumaSize * 4
+                : lumaSize + lumaSize / 2;
+            const uint32_t expectedStride = slotSnapshot.pixelFormat == kPixelFormatBgra
+                ? slotSnapshot.width * 4
+                : slotSnapshot.width;
+            const uint64_t payloadOffset = slotOffset + sizeof(CameraTunerSlotHeader);
+            const bool validSlot =
+                slotSnapshot.width > 0 && slotSnapshot.height > 0 &&
+                slotSnapshot.width <= 8192 && slotSnapshot.height <= 8192 &&
+                (slotSnapshot.pixelFormat == kPixelFormatBgra ||
+                    slotSnapshot.pixelFormat == kPixelFormatNv12) &&
+                slotSnapshot.pixelFormat == globalSnapshot.pixelFormat &&
+                (slotSnapshot.pixelFormat != kPixelFormatNv12 ||
+                    (slotSnapshot.width % 2 == 0 && slotSnapshot.height % 2 == 0)) &&
+                slotSnapshot.stride == expectedStride &&
+                slotSnapshot.frameSize == expectedSize &&
+                slotSnapshot.frameSize <= globalSnapshot.frameCapacity &&
+                slotSnapshot.generation == globalSnapshot.generation &&
+                payloadOffset + slotSnapshot.frameSize <= persistent.mappedSize;
+            if (!validSlot)
+            {
+                LogDiagnosticOnce(invalidHeaderLogged, "invalid CTFRAME2 slot metadata");
+                return false;
+            }
+
+            frame.resize(slotSnapshot.frameSize);
+            memcpy(frame.data(), persistent.view + payloadOffset, slotSnapshot.frameSize);
+            MemoryBarrier();
+            const uint32_t stateAfter = LoadAcquire32(&slot->state);
+            const uint64_t sequenceAfter = LoadAcquire64(&slot->sequence);
+            const uint64_t publicationAfter = LoadAcquire64(&global->publication);
+            if (stateAfter == kSlotStatePublished &&
+                sequenceAfter == publishedSequence &&
+                publicationAfter == publicationBefore)
+            {
+                width = slotSnapshot.width;
+                height = slotSnapshot.height;
+                pixelFormat = slotSnapshot.pixelFormat;
+                sequence = publishedSequence;
+                char message[128]{};
+                sprintf_s(
+                    message,
+                    "CTFRAME2 accepted: %ux%u format=%u bytes=%u seq=%llu (persistent mapping)",
+                    width,
+                    height,
+                    pixelFormat,
+                    slotSnapshot.frameSize,
+                    static_cast<unsigned long long>(sequence));
+                LogDiagnosticOnce(successLogged, message);
+                return true;
+            }
+            SwitchToThread();
+        }
+        }
+        LogDiagnosticOnce(unstableFrameLogged, "CTFRAME2 slot changed during four snapshot attempts");
+        return false;
+    }
