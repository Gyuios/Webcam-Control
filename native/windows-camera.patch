+    void AppendDiagnostic(const char* message)
+    {
+        wil::unique_hfile log(CreateFileW(
+            kDiagnosticPath,
+            FILE_APPEND_DATA,
+            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+            nullptr,
+            OPEN_ALWAYS,
+            FILE_ATTRIBUTE_NORMAL,
+            nullptr));
+        if (!log)
+        {
+            return;
+        }
+        SYSTEMTIME now{};
+        GetSystemTime(&now);
+        char timestamp[40]{};
+        sprintf_s(
+            timestamp,
+            "%04u-%02u-%02uT%02u:%02u:%02u.%03uZ ",
+            now.wYear,
+            now.wMonth,
+            now.wDay,
+            now.wHour,
+            now.wMinute,
+            now.wSecond,
+            now.wMilliseconds);
+        DWORD written = 0;
+        WriteFile(log.get(), timestamp, static_cast<DWORD>(strlen(timestamp)), &written, nullptr);
+        WriteFile(log.get(), message, static_cast<DWORD>(strlen(message)), &written, nullptr);
+        static constexpr char newline[] = "\r\n";
+        WriteFile(log.get(), newline, 2, &written, nullptr);
+    }
+
+    void LogDiagnosticOnce(LONG& gate, const char* message)
+    {
+        if (InterlockedCompareExchange(&gate, 1, 0) == 0)
+        {
+            AppendDiagnostic(message);
+        }
+    }
