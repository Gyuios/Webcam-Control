{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Control Webcam",
  "version": "0.1.0",
  "identifier": "com.minec.controlwebcam",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Control Webcam",
        "width": 1280,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Gyuios",
    "copyright": "© 2026 Gyuios. Todos los derechos reservados.",
    "icon": [
      "icons/app-icon.ico",
      "icons/app-icon.png"
    ],
    "resources": [
      "binaries/control-webcam-bridge-x86_64-pc-windows-msvc.exe",
      "binaries/ffmpeg.exe"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/app-icon.ico"
      }
    }
  }
}
